{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(terraform plan *)",
      "Bash(terraform validate)",
      "Bash(terraform fmt *)",
      "Bash(kubectl get *)",
      "Bash(helm template *)",
      "Bash(helm lint *)"
    ],
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Read(**/.env)",
      "Read(~/.aws/**)",
      "mcp__kubernetes__*_delete",
      "mcp__kubernetes__pods_exec",
      "mcp__kubernetes__pods_run",
      "mcp__kubernetes__resources_create_or_update",
      "mcp__kubernetes__resources_scale",
      "mcp__kubernetes__helm_install",
      "mcp__kubernetes__helm_uninstall"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-infra.ts\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.aws", "~/.ssh", "~/.kube/prod"],
      "allowWrite": ["../.state", "../logs"]
    },
    "network": {
      "allowedDomains": ["registry.terraform.io", "registry.tallowmark.test", "api.anthropic.com"]
    }
  }
}
