{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(terraform plan *)",
      "Bash(terraform validate)",
      "Bash(terraform fmt *)",
      "Bash(kubectl get *)",
      "Bash(helm template *)",
      "Bash(helm lint *)"
    ],
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Read(**/.env)",
      "Read(~/.aws/**)"
    ]
  }
}
