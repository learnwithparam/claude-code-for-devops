{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Read(**/.env)",
      "Read(~/.aws/**)"
    ]
  }
}
